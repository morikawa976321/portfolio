---
import type { Item } from '../data/profile';

// 経歴・研究・受賞の行。期間 | 本文。未確認の仮の値は .pending(開発時だけ見える)
interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul class="rows">
  {
    items.map((i) => (
      <li class:list={['row', { pending: !i.confirmed }]}>
        <span class="when">{i.period}</span>
        <span class="text">{i.text}</span>
      </li>
    ))
  }
</ul>
