---
import type { Item } from '../data/profile';

// 経歴・研究・受賞の1節。期間 | 本文。未確認の仮の値は .pending(開発時だけ見える)
interface Props {
  title: string;
  items: Item[];
}

const { title, items } = Astro.props;
---

<section>
  <h2 class="sec-t">{title}</h2>
  <dl class="rows">
    {
      items.map((i) => (
        <div class:list={{ pending: !i.confirmed }}>
          <dt class="mono sub">{i.period}</dt>
          <dd>{i.text}</dd>
        </div>
      ))
    }
  </dl>
</section>
