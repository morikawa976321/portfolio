---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

// 作品1件: 列の幅いっぱいの 16:10 の写真 → 題 → 一行 → 年。全体が作品ページへのリンク
interface Props {
  work: CollectionEntry<'works'>;
  sizes?: string;
}

const { work, sizes = '(min-width: 700px) 640px, 92vw' } = Astro.props;
const { title, year, summary, cover, coverAlt } = work.data;
---

<a class="card" href={`/works/${work.id}/`}>
  <div class="pic">
    <Image src={cover} alt={coverAlt} widths={[640, 1280, 1920]} sizes={sizes} />
  </div>
  <div class="cap">
    <h3>{title}</h3>
    <p class="sum">{summary}</p>
    <p class="year mono">{year}</p>
  </div>
</a>
