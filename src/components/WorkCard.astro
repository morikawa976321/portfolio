---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, year, summary, cover, coverAlt, context } = work.data;
---

<a class="card" href={`/works/${work.id}/`}>
  <Image src={cover} alt={coverAlt} widths={[400, 800]} sizes="(min-width: 60rem) 30vw, 90vw" class="cover" />
  <p class="meta mono mute">{year}{context && ` · ${context}`}</p>
  <h3>{title}</h3>
  <p class="summary mute">{summary}</p>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
  }
  .cover {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-bottom: var(--s2);
    transition: opacity 0.2s;
  }
  .card:hover .cover {
    opacity: 0.8;
  }
  .card:hover {
    color: inherit;
  }
  .meta {
    font-size: 0.8125rem;
    margin: 0 0 0.25rem;
  }
  h3 {
    font-size: 1rem;
  }
  .summary {
    font-size: 0.875rem;
    line-height: 1.7;
    margin: 0.25rem 0 0;
  }
</style>
