---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

// 作品1件: 4:3 に切った写真 → 題と年(期間があれば期間)→ 一行。全体が作品ページへのリンク。ホバーは題の下線だけ
interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, year, period, summary, cover, coverAlt } = work.data;
---

<li>
  <a class="card" href={`/works/${work.id}/`}>
    <Image
      class="pic"
      src={cover}
      alt={coverAlt}
      widths={[480, 960]}
      sizes="(min-width: 1040px) 400px, (min-width: 601px) 46vw, 92vw"
    />
    <div class="cap">
      <h3>{title}</h3>
      <span class="mono sub">{period ?? year}</span>
    </div>
    <p class="sub line">{summary}</p>
  </a>
</li>
