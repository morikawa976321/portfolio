---
import type { Item } from '../data/profile';

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul>
  {
    items.map((i) => (
      <li class:list={{ pending: !i.confirmed }}>
        <span class="period mono mute">{i.period}</span>
        <span>{i.text}</span>
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 48rem;
  }
  li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--s2);
    margin-bottom: var(--s2);
  }
  .period {
    font-size: 0.875rem;
    padding-top: 0.1em;
  }
  /* 未確認の仮の値(開発サーバーでだけ見える) */
  .pending {
    outline: 1px dashed var(--mute);
    outline-offset: 4px;
    opacity: 0.6;
  }
  @media (max-width: 40rem) {
    li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
