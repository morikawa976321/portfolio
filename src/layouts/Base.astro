---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.affiliation.text } = Astro.props;
const fullTitle = title ? `${title} — ${profile.name.ja}` : `${profile.name.ja} / ${profile.name.en}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!profile.indexable && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Intel+One+Mono&family=Noto+Sans+JP:wght@400;700&display=swap"
    />
  </head>
  <body>
    <header class="page header">
      <a href="/" class="mono home">{profile.name.en.toLowerCase()}</a>
      <nav class="mono">
        <a href="/works/">works</a>
        <a href="/#career">career</a>
        <a href="/#contact">contact</a>
      </nav>
    </header>
    <main class="page">
      <slot />
    </main>
    <footer class="page footer mono mute">
      <span>© {new Date().getFullYear()} {profile.name.en}</span>
    </footer>
  </body>
</html>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s2);
    padding-block: var(--s3);
    font-size: 0.875rem;
  }
  .home {
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: var(--s3);
  }
  @media (max-width: 30rem) {
    nav {
      gap: var(--s2);
    }
  }
  nav a {
    text-decoration: none;
    color: var(--mute);
  }
  nav a:hover {
    color: var(--paper);
  }
  .footer {
    padding-block: var(--s6) var(--s4);
    font-size: 0.8125rem;
  }
</style>
