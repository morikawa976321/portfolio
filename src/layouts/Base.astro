---
import '../styles/global.css';
import { profile } from '../data/profile';

// 見た目の案の比較(docs/visual.md)。開発時だけ src/styles/variants/*.css を全部読み込み、
// URL の ?v=<name> で <html data-v="<name>"> を付けてその案を当てる。決まったら消す。
if (import.meta.env.DEV) import.meta.glob('../styles/variants/*.css', { eager: true });

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.affiliation.text } = Astro.props;
const fullTitle = title ? `${title} — ${profile.name.ja}` : `${profile.name.ja} / ${profile.name.en}`;
const word = profile.name.en.toLowerCase();
const now = new Date();
const updated = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!profile.indexable && <meta name="robots" content="noindex" />}
    {
      import.meta.env.DEV && (
        <script is:inline>
          (function () {
            var p = new URLSearchParams(location.search);
            var v = p.has('v') ? p.get('v') : sessionStorage.getItem('v');
            if (p.has('v')) sessionStorage.setItem('v', v);
            if (v) document.documentElement.dataset.v = v;
            if (p.has('plain')) document.documentElement.dataset.plain = '';
          })();
        </script>
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Intel+One+Mono&family=Noto+Sans+JP:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="page head">
      <a href="/" class="word">{word}</a>
    </header>
    <main class="page">
      <slot />
    </main>
    <footer class="page foot">
      <span class="word">{word}</span>
      <nav>
        {profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
        {profile.links.map((l) => <a href={l.url}>{l.label}</a>)}
      </nav>
      <span class="sub">updated {updated}</span>
    </footer>
  </body>
</html>
