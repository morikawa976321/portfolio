---
import '../styles/global.css';
import { profile } from '../data/profile';

// 全ページ共通の1列: 名前 → 中身 → 連絡先。ナビゲーションは置かず、名前がトップへのリンクを兼ねる(トップでは h1)
interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description = profile.affiliation.text, home = false } = Astro.props;
const fullTitle = title ? `${title} — ${profile.name.ja}` : `${profile.name.ja} / ${profile.name.en}`;
const hasContact = !!profile.email || profile.links.length > 0;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!profile.indexable && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Intel+One+Mono&family=Noto+Sans+JP:wght@400;500&display=swap"
    />
  </head>
  <body>
    <div class="page">
      {
        home ? (
          <h1 class="who">
            <span class="who-ja">{profile.name.ja}</span>
            <span class="mono sub">{profile.name.en}</span>
          </h1>
        ) : (
          <a class="who" href="/">
            <span class="who-ja">{profile.name.ja}</span>
            <span class="mono sub">{profile.name.en}</span>
          </a>
        )
      }
      <slot />
      {
        hasContact && (
          <footer class="contact">
            <h2 class="sec-t">連絡先</h2>
            {profile.email && (
              // メールはリンクにせず文字だけで出す(本人、2026-10-25)
              <p class="mail">{profile.email}</p>
            )}
            {profile.links.length > 0 && (
              <p class="ext">
                {profile.links.map((l) => (
                  <a class="link" href={l.url} rel="noopener">
                    {l.label} ↗
                  </a>
                ))}
              </p>
            )}
          </footer>
        )
      }
    </div>
  </body>
</html>
