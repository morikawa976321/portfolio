---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.affiliation.text } = Astro.props;
const fullTitle = title ? `${title} — ${profile.name.ja}` : `${profile.name.ja} / ${profile.name.en}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!profile.indexable && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Intel+One+Mono&family=Noto+Sans+JP:wght@400;700&display=swap"
    />
  </head>
  <body>
    <header class="page header">
      <a href="/" class="mono home">{profile.name.en.toLowerCase()}</a>
    </header>
    <main class="page">
      <slot />
    </main>
    <footer class="page footer mono mute">
      {profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
      {profile.links.map((l) => <a href={l.url}>{l.label}</a>)}
    </footer>
  </body>
</html>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s2);
    padding-block: var(--s3);
    font-size: 0.875rem;
  }
  .home {
    text-decoration: none;
    white-space: nowrap;
  }
  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    padding-block: var(--s6) var(--s4);
    font-size: 0.8125rem;
  }
</style>
