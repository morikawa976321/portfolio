---
// 一時ページ: GitHub と X のリンクの出し方の比較用。採用案を Base.astro と global.css に入れたら消す
import '../styles/global.css';
import { profile } from '../data/profile';

const links = [
  { label: 'GitHub', handle: 'morikawa976321', host: 'github.com/morikawa976321', url: 'https://github.com/morikawa976321' },
  { label: 'X', handle: '@112358tm', host: 'x.com/112358tm', url: 'https://x.com/112358tm' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>links variants</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Intel+One+Mono&family=Noto+Sans+JP:wght@400;500&display=swap" />
    <style>
      .v { padding-block: 40px 64px; border-top: 1px dashed var(--sub); }
      .tag { margin-bottom: 28px; font-family: var(--mono); font-size: 12px; color: var(--link); }
      .v .contact { margin-top: 48px; }
      .gap { margin-top: 24px; font-size: 13px; }
      /* B: 名前 + ハンドル */
      .b-ext { display: flex; flex-wrap: wrap; gap: 8px 32px; margin-top: 8px; font-size: 14px; }
      .b-ext .sub { margin-right: 8px; font-size: 13px; }
      /* C: URL をそのまま縦に */
      .c-ext { display: grid; row-gap: 4px; margin-top: 8px; font-size: 14px; }
      /* D: 名前の下 */
      .d-ext { display: flex; gap: 20px; margin-top: 8px; font-size: 13px; }
      /* E: 経歴と同じ行の組み */
      .v-e .rows dd { font-size: 15px; }
    </style>
  </head>
  <body>
    <div class="page">
      <section class="v">
        <p class="tag">現状 — メールだけ</p>
        <footer class="contact">
          <h2 class="sec-t">連絡先</h2>
          <p class="mail">{profile.email}</p>
        </footer>
      </section>

      <section class="v">
        <p class="tag">A 文字リンク — いまのコードにある書式(links を埋めるだけ)</p>
        <footer class="contact">
          <h2 class="sec-t">連絡先</h2>
          <p class="mail">{profile.email}</p>
          <p class="ext">
            {links.map((l) => <a class="link" href={l.url} rel="noopener">{l.label} ↗</a>)}
          </p>
        </footer>
      </section>

      <section class="v">
        <p class="tag">B 名前 + ハンドル — どのアカウントかが先に見える</p>
        <footer class="contact">
          <h2 class="sec-t">連絡先</h2>
          <p class="mail">{profile.email}</p>
          <p class="b-ext">
            {
              links.map((l) => (
                <span>
                  <span class="sub">{l.label}</span>
                  <a class="link mono" href={l.url} rel="noopener">{l.handle} ↗</a>
                </span>
              ))
            }
          </p>
        </footer>
      </section>

      <section class="v">
        <p class="tag">C URL をそのまま — 印刷・スクリーンショットでも行き先が読める</p>
        <footer class="contact">
          <h2 class="sec-t">連絡先</h2>
          <p class="mail">{profile.email}</p>
          <p class="c-ext">
            {links.map((l) => <a class="link mono" href={l.url} rel="noopener">{l.host} ↗</a>)}
          </p>
        </footer>
      </section>

      <section class="v">
        <p class="tag">D 名前の下に置く — 開いてすぐ見える(メールは下の連絡先に残す)</p>
        <div class="who">
          <span class="who-ja">{profile.name.ja}</span>
          <span class="mono sub">{profile.name.en}</span>
        </div>
        <p class="d-ext">
          {links.map((l) => <a class="link" href={l.url} rel="noopener">{l.label} ↗</a>)}
        </p>
        <div class="intro">
          <p class="sub aff">{profile.affiliation.text}</p>
        </div>
        <p class="gap sub">(作品・経歴…)</p>
        <footer class="contact">
          <h2 class="sec-t">連絡先</h2>
          <p class="mail">{profile.email}</p>
        </footer>
      </section>

      <section class="v v-e">
        <p class="tag">E 経歴と同じ行の組み — 左に種類、右に値</p>
        <footer class="contact">
          <h2 class="sec-t">連絡先</h2>
          <dl class="rows" style="margin-top: 16px">
            <div>
              <dt class="sub">メール</dt>
              <dd>{profile.email}</dd>
            </div>
            {
              links.map((l) => (
                <div>
                  <dt class="sub">{l.label}</dt>
                  <dd><a class="link mono" href={l.url} rel="noopener">{l.handle} ↗</a></dd>
                </div>
              ))
            }
          </dl>
        </footer>
      </section>
    </div>
  </body>
</html>
