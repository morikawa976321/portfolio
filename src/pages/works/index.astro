---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

// 全作品を1つの格子に、year(最後に手を入れた年)の新しい順。年ごとの見出しは付けない:
// 長く改良を続けている作品が多く、1つの年に置けないため(本人の指摘、2026-10-25)。期間はカードに period で出す
const works = (await getCollection('works', (w) => !w.data.draft)).sort(
  (a, b) => b.data.year - a.data.year || (a.data.featured ?? 99) - (b.data.featured ?? 99),
);
---

<Base title="作品一覧">
  <main class="sub-page">
    <h1 class="title">すべての作品</h1>
    <ul class="grid all">
      {works.map((w) => <WorkCard work={w} />)}
    </ul>
    {/* 作品ページの「← すべての作品」と同じ形。一覧が長いスマホで、末尾から先頭の名前まで戻らずに済むように(本人「作品一覧ページにトップへ戻るボタンがあった方がいいかもしれない」2026-10-25) */}
    <p class="back"><a class="link" href="/">← トップ</a></p>
  </main>
</Base>
