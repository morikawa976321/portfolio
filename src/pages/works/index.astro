---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const works = await getCollection('works', (w) => !w.data.draft);
const years = [...new Set(works.map((w) => w.data.year))].sort((a, b) => b - a);
const byYear = years.map((y) => ({
  year: y,
  works: works.filter((w) => w.data.year === y).sort((a, b) => (a.data.featured ?? 99) - (b.data.featured ?? 99)),
}));
---

<Base title="Works">
  <h1 class="title">Works</h1>
  {
    byYear.map((g) => (
      <section class="year">
        <h2 class="label">{g.year}</h2>
        <div class="grid">
          {g.works.map((w) => (
            <WorkCard work={w} />
          ))}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .title {
    font-size: 1.75rem;
    margin-top: var(--s6);
  }
  .year {
    margin-top: var(--s5);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--s4) var(--s3);
  }
</style>
