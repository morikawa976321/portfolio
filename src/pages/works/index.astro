---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

// 全作品を新しい年から、1件ずつ縦に積む
const works = (await getCollection('works', (w) => !w.data.draft)).sort(
  (a, b) => b.data.year - a.data.year || (a.data.featured ?? 99) - (b.data.featured ?? 99),
);
---

<Base title="Works">
  <div class="ttl">
    <h1>works</h1>
  </div>
  <div class="cards sec">
    {works.map((w) => <WorkCard work={w} />)}
  </div>
</Base>
