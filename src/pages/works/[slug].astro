---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', (w) => !w.data.draft);
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { title, year, period, context, role, tools, summary, cover, coverAlt, links } = work.data;
const { Content } = await render(work);

// 仕様表。無い項目は出さない
const specs = [
  { k: 'year', v: period ?? String(year) },
  { k: 'context', v: context },
  { k: 'role', v: role },
  { k: 'tools', v: tools.join(', ') },
].filter((m) => m.v);
---

<Base title={title} description={summary}>
  <p class="crumb"><a href="/works/" class="textlink">← works</a></p>
  <article>
    <div class="panel">
      <figure class="plate">
        <div class="fig-row">
          <span>図 01</span>
          <span class="sub">{year}</span>
        </div>
        <Image src={cover} alt={coverAlt} widths={[800, 1600]} sizes="(min-width: 900px) 58vw, 100vw" />
        <figcaption>{coverAlt}</figcaption>
      </figure>
      <div class="title">
        <h1>{title}</h1>
        <p class="lead">{summary}</p>
        <dl class="specs">
          {
            specs.map((m) => (
              <div>
                <dt>{m.k}</dt>
                <dd>{m.v}</dd>
              </div>
            ))
          }
        </dl>
        {
          links.length > 0 && (
            <p class="links">
              {links.map((l) => (
                <a class="textlink" href={l.url}>
                  {l.label} →
                </a>
              ))}
            </p>
          )
        }
      </div>
    </div>
    <section class="block">
      <h2>about</h2>
      <div class="prose">
        <Content />
      </div>
    </section>
  </article>
</Base>
