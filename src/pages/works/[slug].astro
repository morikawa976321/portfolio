---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { title, year, context, role, tools, summary } = work.data;
const { Content } = await render(work);

// 年、文脈、担当、道具。無いものは出さない
const facts = (
  [
    ['年', String(year)],
    ['文脈', context],
    ['担当', role],
    ['道具', tools.length ? tools.join(' / ') : undefined],
  ] as const
).filter((f): f is readonly [string, string] => !!f[1]);
---

{/* summary は未記入の間 "" で置いてある。空なら Base の既定の説明文を使う */}
<Base title={title} description={summary || undefined}>
  <main class="sub-page">
    <article class="work">
      <div class="bar">
        <h1 class="title">{title}</h1>
        <p class="nav"><a class="link" href="/works/">← すべての作品</a></p>
      </div>
      {summary && <p class="sub lead-s">{summary}</p>}
      <dl class="meta">
        {
          facts.map(([k, v]) => (
            <div>
              <dt class="sub">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      {/* カバー(cover)はトップと一覧のカードにだけ出し、ここには出さない(本人「カバー画像がトップと作品ページで重複している。トップ画像が作品ページにまだ出ている。」2026-10-25) */}
      <div class="prose">
        <Content />
      </div>
      <p class="nav end"><a class="link" href="/works/">← すべての作品</a></p>
    </article>
  </main>
</Base>
