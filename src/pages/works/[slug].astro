---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', (w) => !w.data.draft);
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { title, year, period, context, role, tools, summary, cover, coverAlt, links } = work.data;
const { Content } = await render(work);

// 札: 年(期間があれば期間)、文脈、担当、道具。無いものは出さない
const chips = [period ?? String(year), context, role, ...tools].filter((c): c is string => !!c);
---

<Base title={title} description={summary}>
  <a href="/works/" class="back link mono">← works</a>
  <article>
    <header class="art-head">
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      <ul class="chips">
        {chips.map((c) => <li class="chip">{c}</li>)}
      </ul>
    </header>
    <div class="cover">
      <Image src={cover} alt={coverAlt} widths={[900, 1800, 2400]} sizes="(min-width: 1200px) 1200px, 100vw" />
    </div>
    <div class="prose">
      <Content />
    </div>
    {
      links.length > 0 && (
        <p class="links">
          {links.map((l) => (
            <a class="link mono" href={l.url}>
              {l.label} ↗
            </a>
          ))}
        </p>
      )
    }
  </article>
</Base>
