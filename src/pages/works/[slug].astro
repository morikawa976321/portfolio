---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', (w) => !w.data.draft);
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { title, year, period, context, role, tools, summary, links } = work.data;
const { Content } = await render(work);

const meta = [
  { k: 'year', v: period ?? String(year) },
  { k: 'context', v: context },
  { k: 'role', v: role },
  { k: 'tools', v: tools.join(', ') },
].filter((m) => m.v);
---

<Base title={title} description={summary}>
  <article>
    <h1>{title}</h1>
    <dl class="meta">
      {
        meta.map((m) => (
          <div>
            <dt class="mono mute">{m.k}</dt>
            <dd>{m.v}</dd>
          </div>
        ))
      }
    </dl>
    <div class="prose">
      <Content />
    </div>
    {
      links.length > 0 && (
        <ul class="links">
          {links.map((l) => (
            <li>
              <a href={l.url}>{l.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </article>
  <p class="back mono"><a href="/works/">← works</a></p>
</Base>

<style>
  h1 {
    font-size: 1.75rem;
    margin-top: var(--s6);
    max-width: var(--text-width);
  }
  .meta {
    margin: var(--s3) 0 var(--s5);
    font-size: 0.875rem;
  }
  .meta div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--s2);
  }
  dd {
    margin: 0;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: var(--s4) 0 0;
  }
  .back {
    margin-top: var(--s5);
    font-size: 0.875rem;
  }
</style>
