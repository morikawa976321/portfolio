---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import ItemList from '../components/ItemList.astro';
import { profile, career, research, awards, visible } from '../data/profile';

const all = await getCollection('works', (w) => !w.data.draft);
const featured = all
  .filter((w) => w.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);
const total = all.length;

const headline = profile.headline.confirmed || import.meta.env.DEV ? profile.headline.text : '';
const sections = [
  { id: 'career', label: 'career', items: visible(career) },
  { id: 'research', label: 'research', items: visible(research) },
  { id: 'awards', label: 'awards', items: visible(awards) },
].filter((s) => s.items.length > 0);
---

<Base>
  <section class="intro">
    <h1>{profile.name.ja}<span class="en mono mute">{profile.name.en}</span></h1>
    <p class="mute">{profile.affiliation.text}</p>
    {headline && <p class="headline">{headline}</p>}
  </section>

  <section class="section">
    <div class="head">
      <h2 class="label">selected works</h2>
      <a href="/works/" class="label all">all works ({total}) →</a>
    </div>
    <div class="grid">
      {featured.map((w) => <WorkCard work={w} />)}
    </div>
  </section>

  {
    sections.map((s) => (
      <section class="section" id={s.id}>
        <h2 class="label">{s.label}</h2>
        <ItemList items={s.items} />
      </section>
    ))
  }

  <section class="section" id="contact">
    <h2 class="label">contact</h2>
    <ul class="links">
      {profile.email && <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>}
      {profile.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .intro {
    margin-top: var(--s6);
  }
  h1 {
    font-size: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s2);
  }
  .en {
    font-size: 1rem;
    font-weight: 400;
  }
  .intro p {
    margin: var(--s1) 0 0;
  }
  .headline {
    margin-top: var(--s3) !important;
    max-width: var(--text-width);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--s5) var(--s4);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s2);
    margin-bottom: var(--s3);
  }
  .head .label {
    margin-bottom: 0;
  }
  .all {
    white-space: nowrap;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
