---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Rows from '../components/Rows.astro';
import { profile, career, research, awards, visible } from '../data/profile';

// 上から 所属 → 一行 → 選抜作品 → 経歴 → 研究・発表 → 受賞・選出(名前と連絡先は Base)
const featured = (await getCollection('works', (w) => !w.data.draft && w.data.featured !== undefined)).sort(
  (a, b) => a.data.featured! - b.data.featured!,
);

const headline = profile.headline.confirmed || import.meta.env.DEV ? profile.headline.text : '';
const sections = [
  { title: '経歴', items: visible(career) },
  { title: '研究・発表', items: visible(research) },
  { title: '受賞・選出', items: visible(awards) },
].filter((s) => s.items.length > 0);
---

<Base home>
  <div class="intro">
    <p class="sub aff">{profile.affiliation.text}</p>
    {headline && <p class="lead">{headline}</p>}
  </div>
  <main>
    <section>
      <div class="sec-h">
        <h2 class="sec-t">選抜作品</h2>
        <a class="link more" href="/works/">すべての作品 →</a>
      </div>
      <ul class="grid">
        {featured.map((w) => <WorkCard work={w} />)}
      </ul>
    </section>
    {
      sections.length > 0 && (
        <div class="profile">
          {sections.map((s) => (
            <Rows title={s.title} items={s.items} />
          ))}
        </div>
      )
    }
  </main>
</Base>
