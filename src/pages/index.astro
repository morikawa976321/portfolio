---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkFigure from '../components/WorkFigure.astro';
import Rows from '../components/Rows.astro';
import { profile, career, research, awards, visible } from '../data/profile';

const featured = (await getCollection('works', (w) => !w.data.draft && w.data.featured !== undefined)).sort(
  (a, b) => a.data.featured! - b.data.featured!,
);

const headline = profile.headline.confirmed || import.meta.env.DEV ? profile.headline.text : '';
const sections = [
  { id: 'career', label: 'career', items: visible(career) },
  { id: 'research', label: 'research', items: visible(research) },
  { id: 'awards', label: 'awards', items: visible(awards) },
].filter((s) => s.items.length > 0);
---

<Base>
  <section class="hero">
    <div class="name">
      <h1>{profile.name.ja}</h1>
      <p class="en sub">{profile.name.en}</p>
      <p class="aff">{profile.affiliation.text}</p>
    </div>
    {headline && <p class="statement">{headline}</p>}
  </section>

  <section class="block" id="works">
    <div class="side">
      <h2>selected works</h2>
      <a href="/works/" class="textlink">all works →</a>
    </div>
    <div class="figs">
      {featured.map((w, i) => <WorkFigure work={w} n={i + 1} />)}
    </div>
  </section>

  {
    sections.map((s) => (
      <section class="block" id={s.id}>
        <h2>{s.label}</h2>
        <Rows items={s.items} />
      </section>
    ))
  }
</Base>
