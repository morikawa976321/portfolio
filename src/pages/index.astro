---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Rows from '../components/Rows.astro';
import { profile, career, research, awards, visible } from '../data/profile';
import { featured as featuredIds } from '../data/featured';

// 上から 所属 → 一行 → 作品(src/data/featured.ts の順)→ 経歴 → 研究・コンペ(名前と連絡先は Base)
const works = await getCollection('works');
const featured = featuredIds.map((id) => {
  const w = works.find((w) => w.id === id);
  if (!w) throw new Error(`featured.ts の ${id} が src/content/works に無い`);
  return w;
});

const headline = profile.headline.confirmed || import.meta.env.DEV ? profile.headline.text : '';
const sections = [
  { title: '経歴', items: visible(career) },
  // 研究・発表と受賞・選出は1件ずつしかないので1つの節にまとめ、新しい順に並べる(本人、2026-10-25)
  {
    title: '研究・コンペ',
    items: visible([...research, ...awards]).sort((a, b) => (b.period ?? '').localeCompare(a.period ?? '')),
  },
].filter((s) => s.items.length > 0);
---

<Base home>
  <div class="intro">
    <p class="sub aff">{profile.affiliation.text}</p>
    {headline && <p class="lead">{headline}</p>}
  </div>
  <main>
    <section>
      <div class="bar sec">
        <h2 class="sec-t">作品</h2>
        <p class="nav"><a class="link" href="/works/">すべての作品 →</a></p>
      </div>
      <ul class="grid">
        {featured.map((w) => <WorkCard work={w} />)}
      </ul>
    </section>
    {
      sections.length > 0 && (
        <div class="profile">
          {sections.map((s) => (
            <Rows title={s.title} items={s.items} />
          ))}
        </div>
      )
    }
  </main>
</Base>
