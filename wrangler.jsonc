// 公開先: Cloudflare Workers の静的アセット(dist/ をそのまま配る)。npm run deploy で上げる。
// Pages は Workers に統合されつつあり、wrangler 4.152 の `pages project create` は Workers へ回されて失敗するため、こちらを使う(2026-10-25)。
// portfolio.m-kw.net(2026-10-25 本人が決定)は custom_domain で割り当てる。m-kw.net の DNS は同じ Cloudflare のアカウントにある
{
  "name": "portfolio",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    // 無い URL には dist/404.html(src/pages/404.astro)を 404 の状態で返す
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "portfolio.m-kw.net", "custom_domain": true }]
}
